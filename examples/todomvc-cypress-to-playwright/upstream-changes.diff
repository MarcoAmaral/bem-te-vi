       xcode: "15.3.0"
     resource_class: macos.m1.medium.gen1
+  # Playwright migration (migration/): browsers and system libraries ship in this image,
+  # tag matches the pinned @playwright/test version
+  playwright:
+    docker:
+      - image: mcr.microsoft.com/playwright:v1.64.0-noble
 
 jobs:
   lint:
@@ -25,6 +30,17 @@ jobs:
       - run: npm run types
       - run: npm run lint
 
+  # Playwright migration: runs beside the Cypress jobs until migration/decommission.md says go
+  playwright:
+    executor: playwright
+    steps:
+      - checkout
+      - run: CYPRESS_INSTALL_BINARY=0 npm ci
+      - run: npm run build
+      - run: npx playwright test
+      - store_artifacts:
+          path: playwright/report
+
 workflows:
   build:
     jobs:
@@ -52,3 +68,10 @@ workflows:
           start: npm start
           # no need to save the workspace after this job
           no-workspace: true
+
+  # Non-blocking: a separate workflow, so nothing in `build` waits for it and a red run here
+  # cannot fail the Cypress workflow. CircleCI has no per-job "allow failure"; keep this
+  # workflow out of any required status check until the parity gate passes.
+  playwright-migration:
+    jobs:
+      - playwright
