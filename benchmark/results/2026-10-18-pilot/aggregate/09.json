      "name": "A-bdd-loyalty-points",
      "dir": "benchmark/cases/A/bdd-loyalty-points",
      "source": "prose",
      "promptMarkdown": "Write BDD scenarios in Gherkin for the user story below.\n\nStory LOY-3: Loyalty points\n\nAs a member of the loyalty programme, I want to earn and redeem points, so that I get discounts on later orders.\n\n- AC-1: A member earns 1 point for every whole dollar of an order's subtotal ($24.99 earns 24 points).\n- AC-2: A member's tier is Basic below 500 points, Silver from 500 points and Gold from 2,000 points. Silver members get 5% off every order and Gold members 10%.\n- AC-3: Redeeming more points than the balance shows \"You don't have enough points.\" and redeems nothing.\n- AC-4: The points page should load fast.\n\nWhere information is missing, state your assumption and continue; do not ask questions. Reply with the deliverable only, as Markdown, starting at its first line, with no introduction and no code fence around it. Do not create or edit files.",
      "runsPerCase": 3,
      "timeoutSeconds": 600,
      "maxTurns": 15,
      "graders": [
        {
          "name": "con-message-quoted",
          "type": "regex",
          "weight": 1,
          "config": {
            "target": "last_message",
            "pattern": "(?:Then|And)\\b[^\\n]*You don.t have enough points",
            "flags": "i",
            "match": "contains"
          }
        },
        {
          "name": "con-outline-examples",
          "type": "regex",
          "weight": 1,
          "config": {
            "target": "last_message",
            "pattern": "Scenario Outline:[\\s\\S]*?Examples:",
            "flags": "",
            "match": "contains"
          }
        },
        {
          "name": "con-tier-boundaries",
          "type": "regex",
          "weight": 1,
          "config": {
            "target": "last_message",
            "pattern": "^(?=[\\s\\S]*(?<![\\d.,])499(?![\\d.,]))(?=[\\s\\S]*(?<![\\d.,])500(?![\\d.,]))(?=[\\s\\S]*(?<![\\d.,])1,?999(?![\\d.,]))(?=[\\s\\S]*(?<![\\d.,])2,?000(?![\\d.,]))",
            "flags": "",
            "match": "contains"
          }
        },
        {
          "name": "con-vague-ac-flagged",
          "type": "regex",
          "weight": 1,
          "config": {
            "target": "last_message",
            "pattern": "(?:\\bAC[- ]?0?4\\b|load fast|loads? quickly)[\\s\\S]{0,400}?(?:measurable|vague|ambiguous|testable|not specific|undefined|subjective|no (?:threshold|target)|clarif)",
            "flags": "i",
            "match": "contains"
          }
        },
        {
          "name": "fmt-every-scenario-tagged",
          "type": "regex",
          "weight": 1,
          "config": {
            "target": "last_message",
            "pattern": "^(?![ \\t]*@)[^\\n]*\\n[ \\t]*Scenario(?: Outline)?:",
            "flags": "m",
            "match": "not_contains"
          }
        },
        {
          "name": "fmt-feature-header",
          "type": "regex",
          "weight": 1,
          "config": {
            "target": "last_message",
            "pattern": "^[ \\t]*Feature:[^\\n]*\\n(?:[^\\n]*\\n){0,3}?[ \\t]*As an?\\b[^\\n]*\\n[ \\t]*I want\\b[^\\n]*\\n[ \\t]*So that\\b",
            "flags": "im",
            "match": "contains"
          }
        }
      ],
